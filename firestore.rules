rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath());
    }

    function profile() {
      return get(userPath()).data;
    }

    function isMaster() {
      return hasProfile()
        && profile().active == true
        && (
          request.auth.token.get('role', '') == 'master'
          || profile().get('platformRole', '') == 'master'
          || profile().role == 'master'
        );
    }

    function isManager() {
      return hasProfile()
        && profile().active == true
        && validManagerAccess(profile());
    }

    function isPlayer() {
      return hasProfile()
        && profile().active == true
        && validPlayerAccess(profile());
    }

    function sameOrganization(data) {
      return hasProfile()
        && profile().organizationId != null
        && data.organizationId == profile().organizationId;
    }

    function managerCanWrite(data) {
      return isMaster() || (isManager() && sameOrganization(data));
    }

    function validManagerAccess(data) {
      return data.role == 'manager'
        && (
          (
            data.get('managerInviteId', '') is string
            && data.get('managerInviteId', '') != ''
            && exists(/databases/$(database)/documents/managerInvites/$(data.get('managerInviteId', '')))
            && get(/databases/$(database)/documents/managerInvites/$(data.get('managerInviteId', ''))).data.email
              == request.auth.token.email
            && get(/databases/$(database)/documents/managerInvites/$(data.get('managerInviteId', ''))).data.status
              != 'disabled'
            && data.organizationId
              == get(/databases/$(database)/documents/managerInvites/$(data.get('managerInviteId', ''))).data.organizationId
          )
          ||
          (
            exists(/databases/$(database)/documents/managerInvites/$(request.auth.token.email))
            && get(/databases/$(database)/documents/managerInvites/$(request.auth.token.email)).data.status
              != 'disabled'
            && data.organizationId
              == get(/databases/$(database)/documents/managerInvites/$(request.auth.token.email)).data.organizationId
          )
        );
    }

    function validPlayerAccess(data) {
      return data.role == 'player'
        && data.playerId is string
        && exists(/databases/$(database)/documents/players/$(data.playerId))
        && get(/databases/$(database)/documents/players/$(data.playerId)).data.email
          == request.auth.token.email
        && data.organizationId
          == get(/databases/$(database)/documents/players/$(data.playerId)).data.organizationId;
    }

    function validOwnAccess(data) {
      return (
        data.role == 'master'
        && (
          request.auth.token.get('role', '') == 'master'
          || (hasProfile() && (profile().get('platformRole', '') == 'master' || profile().role == 'master'))
        )
      ) || validManagerAccess(data) || validPlayerAccess(data);
    }

    function validStatSubmissionTeam(data) {
      let matchData = get(/databases/$(database)/documents/matches/$(data.matchId)).data;
      let playerData = get(/databases/$(database)/documents/players/$(data.playerId)).data;
      return (
          matchData.get('matchType', 'teams') == 'draw'
          && (
            (
              data.teamId == matchData.homeTeamId
              && data.playerId in matchData.get('homePlayerIds', [])
            )
            ||
            (
              data.teamId == matchData.awayTeamId
              && data.playerId in matchData.get('awayPlayerIds', [])
            )
          )
        )
        || (
          data.teamId == playerData.teamId
          && (
            data.teamId == matchData.homeTeamId
            || data.teamId == matchData.awayTeamId
          )
        );
    }

    function validCheckinParticipant(data) {
      let matchData = get(/databases/$(database)/documents/matches/$(data.matchId)).data;
      let playerData = get(/databases/$(database)/documents/players/$(data.playerId)).data;
      return exists(/databases/$(database)/documents/matches/$(data.matchId))
        && exists(/databases/$(database)/documents/players/$(data.playerId))
        && matchData.organizationId == data.organizationId
        && playerData.organizationId == data.organizationId
        && (
          (
            matchData.get('matchType', 'teams') == 'draw'
            && data.playerId in matchData.get('selectedPlayerIds', [])
          )
          ||
          (
            matchData.get('matchType', 'teams') == 'teams'
            && (
              playerData.teamId == matchData.homeTeamId
              || playerData.teamId == matchData.awayTeamId
            )
          )
        );
    }

    function validConfirmationParticipant(data) {
      let matchData = get(/databases/$(database)/documents/matches/$(data.matchId)).data;
      let playerData = get(/databases/$(database)/documents/players/$(data.playerId)).data;
      return exists(/databases/$(database)/documents/matches/$(data.matchId))
        && exists(/databases/$(database)/documents/players/$(data.playerId))
        && matchData.organizationId == data.organizationId
        && playerData.organizationId == data.organizationId
        && (
          (
            matchData.get('matchType', 'teams') == 'draw'
            && data.playerId in matchData.get('selectedPlayerIds', [])
          )
          ||
          (
            matchData.get('matchType', 'teams') == 'teams'
            && (
              playerData.teamId == matchData.homeTeamId
              || playerData.teamId == matchData.awayTeamId
            )
          )
        );
    }

    function validPlayerCheckinConfirmation(data) {
      let matchData = get(/databases/$(database)/documents/matches/$(data.matchId)).data;
      let confirmationId = data.matchId + '-' + data.playerId;
      return matchData.get('requiresConfirmation', false) != true
        || (
          exists(/databases/$(database)/documents/matchConfirmations/$(confirmationId))
          && get(/databases/$(database)/documents/matchConfirmations/$(confirmationId)).data.status == 'going'
        );
    }

    function validCheckinWindow(data) {
      let matchData = get(/databases/$(database)/documents/matches/$(data.matchId)).data;
      return matchData.get('checkinOpensAtMs', 0) == 0
        || (
          request.time.toMillis() >= matchData.checkinOpensAtMs
          && request.time.toMillis() <= matchData.checkinClosesAtMs
        );
    }

    match /users/{userId} {
      allow read: if isMaster() || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && validOwnAccess(request.resource.data);

      allow update: if isMaster()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.active == resource.data.active
          && validOwnAccess(request.resource.data)
        );
      allow delete: if isMaster();
    }

    match /organizations/{organizationId} {
      allow read: if isMaster()
        || (hasProfile() && profile().organizationId == organizationId);
      allow create, delete: if isMaster();
      allow update: if isMaster()
        || (isManager() && profile().organizationId == organizationId);
    }

    match /managerInvites/{email} {
      allow read: if isMaster()
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow create, delete: if isMaster();
      allow update: if isMaster()
        || (
          signedIn()
          && resource.data.email == request.auth.token.email
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.email == resource.data.email
          && request.resource.data.organizationId == resource.data.organizationId
        );
    }

    match /players/{playerId} {
      allow read: if isMaster()
        || sameOrganization(resource.data)
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow create: if managerCanWrite(request.resource.data);
      allow update: if managerCanWrite(request.resource.data)
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isMaster() || (isManager() && sameOrganization(resource.data));
    }

    match /teams/{documentId} {
      allow read: if isMaster() || sameOrganization(resource.data);
      allow create: if managerCanWrite(request.resource.data);
      allow update: if managerCanWrite(request.resource.data)
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isMaster() || (isManager() && sameOrganization(resource.data));
    }

    match /venues/{documentId} {
      allow read: if isMaster() || sameOrganization(resource.data);
      allow create: if managerCanWrite(request.resource.data);
      allow update: if managerCanWrite(request.resource.data)
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isMaster() || (isManager() && sameOrganization(resource.data));
    }

    match /leagues/{documentId} {
      allow read: if isMaster() || sameOrganization(resource.data);
      allow create: if managerCanWrite(request.resource.data);
      allow update: if managerCanWrite(request.resource.data)
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isMaster() || (isManager() && sameOrganization(resource.data));
    }

    match /matches/{documentId} {
      allow read: if isMaster() || sameOrganization(resource.data);
      allow create: if managerCanWrite(request.resource.data);
      allow update: if managerCanWrite(request.resource.data)
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isMaster() || (isManager() && sameOrganization(resource.data));
    }

    match /checkins/{checkinId} {
      allow read: if isMaster() || sameOrganization(resource.data);
      allow create: if isMaster()
        || (
          validCheckinParticipant(request.resource.data)
          && validCheckinWindow(request.resource.data)
          && request.resource.data.validated == true
          && (
            (
              isPlayer()
              && request.resource.data.playerId == profile().playerId
              && validPlayerCheckinConfirmation(request.resource.data)
            )
            ||
            (
              isManager()
              && sameOrganization(request.resource.data)
              && request.resource.data.get('source', '') == 'manager'
              && request.resource.data.get('registeredByUserId', '') == request.auth.uid
            )
          )
        );
      allow update: if isMaster()
        || (
          isManager()
          && sameOrganization(resource.data)
          && validCheckinWindow(request.resource.data)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.matchId == resource.data.matchId
          && request.resource.data.playerId == resource.data.playerId
        );
      allow delete: if isMaster() || (isManager() && sameOrganization(resource.data));
    }

    match /matchConfirmations/{confirmationId} {
      allow read: if isMaster() || sameOrganization(resource.data);

      allow create: if validConfirmationParticipant(request.resource.data)
        && request.resource.data.status in ['going', 'maybe', 'declined']
        && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status == 'scheduled'
        && (
          (
            isPlayer()
            && request.resource.data.playerId == profile().playerId
            && request.resource.data.source == 'player'
          )
          ||
          (
            isManager()
            && sameOrganization(request.resource.data)
            && request.resource.data.source == 'manager'
          )
        );

      allow update: if validConfirmationParticipant(request.resource.data)
        && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status == 'scheduled'
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.matchId == resource.data.matchId
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.status in ['going', 'maybe', 'declined']
        && (
          (
            isPlayer()
            && resource.data.playerId == profile().playerId
            && request.resource.data.source == 'player'
          )
          ||
          (
            isManager()
            && sameOrganization(request.resource.data)
            && request.resource.data.source == 'manager'
          )
        );

      allow delete: if isMaster() || (isManager() && sameOrganization(resource.data));
    }

    match /statSubmissions/{submissionId} {
      allow read: if isMaster()
        || (isManager() && sameOrganization(resource.data))
        || (
          isPlayer()
          && resource.data.playerId == profile().playerId
          && sameOrganization(resource.data)
        );

      allow create: if isPlayer()
        && request.resource.data.playerId == profile().playerId
        && sameOrganization(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.goals is int
        && request.resource.data.goals >= 0
        && request.resource.data.goals <= 30
        && request.resource.data.assists is int
        && request.resource.data.assists >= 0
        && request.resource.data.assists <= 30
        && request.resource.data.goals + request.resource.data.assists > 0
        && exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId))
        && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.organizationId
          == profile().organizationId
        && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status
          == 'finished'
        && exists(/databases/$(database)/documents/players/$(profile().playerId))
        && validStatSubmissionTeam(request.resource.data);

      allow update: if (
          managerCanWrite(request.resource.data)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.playerId == resource.data.playerId
          && request.resource.data.matchId == resource.data.matchId
          && request.resource.data.teamId == resource.data.teamId
          && request.resource.data.goals == resource.data.goals
          && request.resource.data.assists == resource.data.assists
        )
        || (
          isPlayer()
          && resource.data.playerId == profile().playerId
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
          && request.resource.data.playerId == resource.data.playerId
          && request.resource.data.matchId == resource.data.matchId
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.teamId == resource.data.teamId
          && request.resource.data.goals is int
          && request.resource.data.goals >= 0
          && request.resource.data.goals <= 30
          && request.resource.data.assists is int
          && request.resource.data.assists >= 0
          && request.resource.data.assists <= 30
          && request.resource.data.goals + request.resource.data.assists > 0
        );

      allow delete: if isMaster() || (isManager() && sameOrganization(resource.data));
    }

    match /financialSettings/{documentId} {
      allow read: if isMaster() || (isManager() && sameOrganization(resource.data));
      allow create: if managerCanWrite(request.resource.data);
      allow update: if managerCanWrite(request.resource.data)
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isMaster() || (isManager() && sameOrganization(resource.data));
    }

    match /financialCharges/{documentId} {
      allow read: if isMaster() || (isManager() && sameOrganization(resource.data));
      allow create: if managerCanWrite(request.resource.data)
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow update: if managerCanWrite(request.resource.data)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow delete: if isMaster() || (isManager() && sameOrganization(resource.data));
    }

    match /financialExpenses/{documentId} {
      allow read: if isMaster() || (isManager() && sameOrganization(resource.data));
      allow create: if managerCanWrite(request.resource.data)
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow update: if managerCanWrite(request.resource.data)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow delete: if isMaster() || (isManager() && sameOrganization(resource.data));
    }

    match /publicLeagues/{leagueId} {
      allow read: if resource.data.isPublic == true
        || isMaster()
        || sameOrganization(resource.data);
      allow create: if managerCanWrite(request.resource.data)
        && request.resource.data.id == leagueId
        && request.resource.data.isPublic == true;
      allow update: if managerCanWrite(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isMaster() || (isManager() && sameOrganization(resource.data));

      match /matches/{matchId} {
        function publicLeague() {
          return get(/databases/$(database)/documents/publicLeagues/$(leagueId));
        }

        allow read: if (
            publicLeague().data.isPublic == true
          )
          || isMaster()
          || sameOrganization(resource.data);
        allow create: if managerCanWrite(request.resource.data)
          && request.resource.data.id == matchId
          && request.resource.data.leagueId == leagueId;
        allow update: if managerCanWrite(request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.leagueId == leagueId
          && request.resource.data.organizationId == resource.data.organizationId;
        allow delete: if isMaster() || (isManager() && sameOrganization(resource.data));
      }
    }

    match /auditLogs/{logId} {
      allow read: if isMaster() || (isManager() && sameOrganization(resource.data));
      allow create: if isMaster()
        || (
          hasProfile()
          && sameOrganization(request.resource.data)
          && request.resource.data.actorName == profile().name
        );
      allow update, delete: if false;
    }
  }
}
